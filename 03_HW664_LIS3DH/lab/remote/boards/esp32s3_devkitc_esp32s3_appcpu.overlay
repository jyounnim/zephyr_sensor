/*
 * Overlay for 03_HW664_LIS3DH - core1 (appcpu) image
 *
 * Identical convention to Lab 01: I2C1 (NOT I2C0) at SDA=GPIO4 /
 * SCL=GPIO5, since core1 must own a physically different I2C
 * controller than core0's LIS3DSH bus. No sensor devicetree nodes
 * here - core1 never talks to the LIS3DSH directly, only to the
 * SSD1306 (probed at runtime by src/ssd1306_display.c).
 */

#include <dt-bindings/pinctrl/esp32s3-pinctrl.h>
#include <zephyr/dt-bindings/i2c/i2c.h>

&pinctrl {
	i2c1_default: i2c1_default {
		group1 {
			pinmux = <I2C1_SDA_GPIO4>, <I2C1_SCL_GPIO5>;
			bias-pull-up;
			drive-open-drain;
			output-high;
		};
	};
};

&i2c1 {
	status = "okay";
	pinctrl-0 = <&i2c1_default>;
	pinctrl-names = "default";
	clock-frequency = <I2C_BITRATE_STANDARD>; /* 100 kHz */
};

&ipm0 {
	status = "okay";
};
